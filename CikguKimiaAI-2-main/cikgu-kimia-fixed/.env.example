# .env.example — copy to .env.local and fill in your values

# Required
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
APP_URL=

# Optional — override Gemini model IDs (defaults shown)
GEMINI_MODEL_CHAT=gemini-2.0-flash
GEMINI_MODEL_ANALYSER=gemini-2.0-flash-lite
GEMINI_MODEL_SUMMARY=gemini-2.0-flash-lite

# Required for the /api/cron/send-reminders endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=
