{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Stores student memory and progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Student email" },
        "weakTopics": { "type": "array", "description": "List of topics student struggles with" },
        "identifiedMistakes": { "type": "array", "description": "List of common mistakes caught by Cikgu" },
        "examPapersAnalysis": { "type": "array", "description": "Summaries from uploaded papers" },
        "lastExamScore": { "type": "string", "description": "Latest score achieved" },
        "neuralEnergy": { "type": "number", "description": "Remaining AI interaction credits" },
        "lastEnergyRefill": { "type": "number", "description": "Unix timestamp of last regen" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "chat": {
      "title": "Chat Message",
      "description": "Stores chat history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "topicId": { "type": "string" }
      },
      "required": ["userId", "role", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Main user document."
    },
    "/users/{userId}/history/{msgId}": {
      "schema": "chat",
      "description": "Chat history subcollection."
    }
  }
}
