rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() < 256;
    }

    function isValidUser() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'uid','email','displayName','photoURL',
        'weakTopics','identifiedMistakes','examPapersAnalysis',
        'chapterMastery','streakCount','lastActiveDay',
        'messageCount','dailyMessageCount','dailyMessageDate',
        'reminderPrefs','createdAt','updatedAt'
      ])
      && (!('weakTopics' in data) || data.weakTopics is list)
      && (!('identifiedMistakes' in data) || data.identifiedMistakes is list)
      && (!('uid' in data) || data.uid == request.auth.uid);
    }

    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasOnly(['userId','role','text','timestamp','assets'])
      && data.role in ['user','model']
      && data.text is string
      && data.text.size() > 0
      && data.text.size() < 50000
      && data.userId == request.auth.uid
      && data.timestamp == request.time;
    }

    // ─── user profiles ────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;  // no cross-user listing

      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser()
                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
                    && isValidUser()
                    // uid field must not change once set
                    && (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid)
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);

      // ─── chat history ──────────────────────────────────────────────────
      match /history/{msgId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create:    if isOwner(userId) && isValidId(userId) && isValidMessage();
        allow update, delete: if false;  // messages are immutable
      }
    }

    // ─── telegram link codes (short-lived, write-once by anyone signed-in) ─
    match /telegram_link_codes/{code} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['chatId','createdAt'])
                    && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn();
      allow update: if false;
    }

    // ─── global insights (read-only for clients; server writes via Admin SDK) ─
    match /global_insights/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;  // server-side Admin SDK only
    }

    // ─── public heartbeat (unauthenticated health check) ──────────────────
    match /system/heartbeat {
      allow get: if true;
    }
  }
}
